<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.media.MediaView?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/21"
            fx:controller="ru.videoplayer.controller.PlayerController">

    <top>
        <HBox spacing="10" styleClass="menu-bar">
            <Button text="Открыть"
                    onAction="#openVideo"/>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="videoContainer"
                   styleClass="video-container">

            <MediaView fx:id="mediaView"
                       preserveRatio="true"/>

            <Label fx:id="placeholderLabel"
                   text="No video loaded"
                   styleClass="placeholder-text"/>

        </StackPane>
    </center>

    <bottom>
        <VBox spacing="8" styleClass="controls">

            <Slider fx:id="progressSlider"
                    min="0"
                    max="100"
                    value="0"/>

            <HBox spacing="10"
                  alignment="CENTER">

                <Button text="⏮"/>
                <Button text="▶"
                        onAction="#play"/>
                <Button text="⏸"
                        onAction="#pause"/>
                <Button text="⏹"
                        onAction="#stop"/>

                <Label fx:id="timeLabel"
                       text="00:00 / 00:00"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label text="🔊"/>

                <Slider fx:id="volumeSlider"
                        min="0"
                        max="1"
                        value="0.5"
                        prefWidth="120"/>

                <Button text="⛶"/>

            </HBox>

        </VBox>
    </bottom>

</BorderPane>